; ===================================================
; Blitz Basic 2: Precyzyjny Pomiar Wydajnosci (Raster Bars)
; ===================================================

; 1. Odcinamy system operacyjny Amigi i przechodzimy do czystego sprzDtu
BLITZ

; 2. Alokujemy pamiDD dla naszej grafiki w Chip RAM
BitMap 0,320,200,4    ; Rezerwujemy bitmapD nr 0: 320x200, 4 plany (16 kolorC3w)

; 3. Inicjalizujemy listD instrukcji dla ukEadu Copper (odpowiednik ekranu)
; Parametry: Nr_Listy, Startowa_Linia_Y, WysokoED, Tryb, Plany_Bitowe, Kolory, Sprites
InitCopList 0,44,200,$00014,4,16,0

; 4. Aktywujemy i tworzymy wyEwietlacz sprzDtowy
CreateDisplay 0
DisplayBitMap 0,0

; PDtla gEC3wna programu (Zamieniona na poprawnD skEadniD Repeat...Forever)
Repeat
    ; Czekamy na powrC3t pionowy (VBL) - poczDtek nowej klatki
    VWait

    ; --- SEKCJA 1: CZYSZCZENIE EKRANU ---
    ; Czekamy sprzDtowo na 40. liniD rastra
    ;VPos 40
    ; Zmieniamy kolor tEa w rejestrze Amigi ($DFF180) na NIEBIESKI
    Poke.w $DFF180,$00F

    ; Czyszczenie bitmapy za pomocD super szybkiego Blittera w Blitzu
    Cls 0

    ; --- SEKCJA 2: LOGIKA ---
    ; Czekamy sprzDtowo na 100. liniD rastra
    ;VPos 100
    ; Zmieniamy kolor tEa na CZERWONY
    Poke.w $DFF180,$F00

    ; Obliczenia matematyczne (.f oznacza zmiennD typu Float)
    For i.l = 1 To 20
        a.f = Sin(i.l) * Cos(i.l)
    Next

    ; --- SEKCJA 3: GRAFIKA ---
    ; Czekamy sprzDtowo na 150. liniD rastra
    ;VPos 150
    ; Zmieniamy kolor tEa na ZIELONY
    Poke.w $DFF180,$0F0

    ; Rysujemy dwie kropki na naszej bitmapie
    For i.l = 1 To 60
        Plot Rnd(320),Rnd(200),1
    Next

    ; --- KONIEC: POWRCT DO CZERNI ---
    ; Na 190. linii gasimy belki, dajDc czarny kolor na resztD ekranu
    ;VPos 190
    Poke.w $DFF180,$000

    ; Sprawdzamy stan lewego klawisza myszy bezpoErednio przez rejestr CIA ($DFF00C)
    ; (JeEli bit 6 jest rC3wny 0, oznacza to klikniDcie i przerywamy pDtlD przez Exit)
    Bit.b = Peek($bfe001)
    If (Bit.b & 64) = 0 Then Goto Wyjscie

Forever

Wyjscie:
Poke.w $DFF180,$000
VWait
; KoEczymy dziaEanie programu i bezpiecznie przywracamy system operacyjny AmigaOS
AMIGA
End


